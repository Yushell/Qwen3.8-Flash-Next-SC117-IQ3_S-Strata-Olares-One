# Environment for flashnext-serve.sh (sourced by the supervisor).
# Winner of the 2026-10-14 Flash-Next recipe comparison; every arm was measured with the same
# battery (see the recipe note in the vault).
#
# CONFIG selects the weights + flags. The other tested arms are drop-in swaps:
#   IQ3_XXS   /opt/strata/strata-arm0-iq3xxs-tuned.json   fastest, 84.46% top-1
#   IQ3_S     /opt/strata/strata-arm1-iq3s-tuned.json     balanced, 87.69% top-1
#   NVFP4     /opt/strata/strata-nvfp4-gptq.json          quality,  92.15% top-1
# After editing CONFIG, the unit needs the matching VRAM/RSS numbers below (the engine's own
# values are in the supervisor log's 'load check' line).
STRATA_DIR=/opt/strata
CONFIG=/opt/strata/strata-arm1-sc117-iq3s.json
PORT=8001
ALIAS=qwen3.8-flash-next-sc117-iq3_s
# Whole-GPU ceiling: the card also drives the display, so the supervisor kills the lane if
# total GPU use passes this twice in a row. Measured normal use is in the recipe note.
VRAM_CAP_MIB=23700
# Load checks: the engine's own VRAM and the process tree's resident experts. A lane that
# loaded without filling its expert tier fails these on purpose (it would be slow, not broken).
VRAM_FLOOR_MIB=14000
RSS_FLOOR_GIB=35
READY_TIMEOUT_S=900
# Thinking level for requests that send no reasoning_effort. Strata decides thinking per
# request; `llm start qwen38-flashnext-unit --reasoning low|medium|xhigh|none` rewrites these
# two keys, and ~/.local/bin/flashnext-serve.sh applies REASONING_EFFORT as the engine's
# /settings default after load (REASONING=off -> the engine's "none"). low|medium|xhigh only.
REASONING=on
REASONING_EFFORT=medium
# 0.2.2: "none" = serve without a key (the server warns once). No client needs a header.
STRATA_API_KEY=none
